---
// Калькулятор стоимости (по мотивам PriceCalculator из «Возможностей» webik.tech).
// Цены — только из прайса клиента. Результат передаётся в форму заявки текстом расчёта.
// Без JS показывается базовая цена и ссылка на форму.
interface Props {
  title: string;
  /** Базовая цена, ₽ */
  base: number;
  /** Ползунки: цена за единицу × количество */
  sliders?: { id: string; label: string; unit: string; min: number; max: number; step?: number; value?: number; price: number }[];
  /** Опции-переключатели с фиксированной ценой */
  options?: { id: string; label: string; price: number }[];
  /** Обязательная оговорка: что входит и что расчёт предварительный */
  note: string;
  /** Адрес формы заявки; расчёт уйдёт в параметр ?message= */
  formHref: string;
  cta?: string;
}
const { title, base, sliders = [], options = [], note, formHref, cta = 'Оставить заявку с этим расчётом' } = Astro.props;
const rub = (n: number) => `${n.toLocaleString('ru-RU')} ₽`;
const uid = `wbc-${Math.random().toString(36).slice(2, 8)}`;
---

<section class="wb-calc" data-wb-calc data-base={base} aria-labelledby={`${uid}-h`}>
  <h3 id={`${uid}-h`}>{title}</h3>
  <div class="wb-calc-body">
    <div class="wb-calc-controls">
      {
        sliders.map((s) => (
          <div class="wb-calc-slider" data-price={s.price} data-label={s.label} data-unit={s.unit}>
            <div class="wb-calc-row">
              <label for={`${uid}-${s.id}`}>{s.label}</label>
              <output for={`${uid}-${s.id}`}>
                {s.value ?? s.min} {s.unit}
              </output>
            </div>
            <input id={`${uid}-${s.id}`} type="range" min={s.min} max={s.max} step={s.step ?? 1} value={s.value ?? s.min} />
          </div>
        ))
      }
      {
        options.length > 0 && (
          <fieldset class="wb-calc-options">
            <legend>Дополнительно</legend>
            {options.map((o) => (
              <label class="wb-calc-option" data-price={o.price} data-label={o.label}>
                <input type="checkbox" />
                <span class="wb-calc-option-label">{o.label}</span>
                <span class="wb-calc-option-price">+{rub(o.price)}</span>
              </label>
            ))}
          </fieldset>
        )
      }
    </div>
    <div class="wb-calc-total">
      <span class="wb-calc-total-label">Предварительно</span>
      <output class="wb-calc-sum" aria-live="polite">{rub(base)}</output>
      <p class="wb-calc-note">{note}</p>
      <a class="wb-calc-cta" href={formHref} data-form-href={formHref}>{cta}</a>
    </div>
  </div>
</section>

<style>
  .wb-calc {
    display: grid;
    gap: 20px;
    padding: clamp(20px, 3vw, 32px);
    border-radius: var(--wb-radius, 16px);
    background: var(--wb-panel, #f3f1ec);
    color: var(--wb-ink, #1a1a1a);
  }
  .wb-calc h3 { margin: 0; }
  .wb-calc-body { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 32px; align-items: start; }
  @media (max-width: 760px) { .wb-calc-body { grid-template-columns: minmax(0, 1fr); } }
  .wb-calc-controls { display: grid; gap: 24px; }
  .wb-calc-row { display: flex; justify-content: space-between; gap: 12px; align-items: baseline; }
  .wb-calc-row label, .wb-calc-options legend { font-weight: 600; }
  .wb-calc-row output { font-variant-numeric: tabular-nums; color: var(--wb-ink-soft, #555); }
  .wb-calc-slider input { width: 100%; height: 32px; accent-color: var(--wb-brand, #1a1a1a); }
  .wb-calc-options { border: 0; margin: 0; padding: 0; display: grid; gap: 8px; }
  .wb-calc-options legend { padding: 0; margin-bottom: 8px; }
  .wb-calc-option {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 12px;
    align-items: center;
    min-height: 48px;
    padding: 0 14px;
    border-radius: var(--wb-radius-sm, 10px);
    background: var(--wb-surface, #fff);
    border: 1px solid var(--wb-line, rgb(0 0 0 / 0.1));
    cursor: pointer;
  }
  .wb-calc-option input { width: 20px; height: 20px; accent-color: var(--wb-brand, #1a1a1a); }
  .wb-calc-option:has(input:checked) { border-color: var(--wb-brand, #1a1a1a); }
  .wb-calc-option:has(input:focus-visible) { outline: 3px solid var(--wb-focus, #1a1a1a); outline-offset: 2px; }
  .wb-calc-option-price { font-variant-numeric: tabular-nums; color: var(--wb-ink-soft, #555); white-space: nowrap; }
  .wb-calc-total {
    display: grid;
    gap: 8px;
    padding: 24px;
    border-radius: var(--wb-radius-sm, 12px);
    background: var(--wb-surface, #fff);
    position: sticky;
    top: 24px;
  }
  .wb-calc-total-label { font-size: 14px; color: var(--wb-ink-soft, #555); }
  .wb-calc-sum { font-size: clamp(2rem, 1.6rem + 1.5vw, 2.75rem); font-weight: 700; line-height: 1.1; font-variant-numeric: tabular-nums; }
  .wb-calc-note { margin: 0; font-size: 14px; color: var(--wb-ink-soft, #555); text-wrap: pretty; }
  .wb-calc-cta {
    margin-top: 8px;
    display: inline-flex;
    justify-content: center;
    align-items: center;
    min-height: 48px;
    padding: 0 20px;
    border-radius: var(--wb-radius-sm, 12px);
    background: var(--wb-action, #1a1a1a);
    color: var(--wb-on-action, #fff);
    font-weight: 700;
    text-decoration: none;
    transition: transform 120ms ease-out;
  }
  .wb-calc-cta:active { transform: scale(0.97); }
  .wb-calc-cta:focus-visible { outline: 3px solid var(--wb-focus, #1a1a1a); outline-offset: 3px; }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-wb-calc]')) {
    const base = Number(root.dataset.base);
    const sum = root.querySelector<HTMLOutputElement>('.wb-calc-sum')!;
    const cta = root.querySelector<HTMLAnchorElement>('.wb-calc-cta')!;
    const rub = (n: number) => `${n.toLocaleString('ru-RU')} ₽`;

    const update = () => {
      let total = base;
      const lines: string[] = [];
      for (const s of root.querySelectorAll<HTMLElement>('.wb-calc-slider')) {
        const input = s.querySelector('input')!;
        const n = Number(input.value);
        total += n * Number(s.dataset.price);
        s.querySelector('output')!.textContent = `${n} ${s.dataset.unit}`;
        lines.push(`${s.dataset.label}: ${n} ${s.dataset.unit}`);
      }
      for (const o of root.querySelectorAll<HTMLElement>('.wb-calc-option')) {
        if (o.querySelector('input')!.checked) {
          total += Number(o.dataset.price);
          lines.push(o.dataset.label!);
        }
      }
      sum.textContent = rub(total);
      const message = `Расчёт на сайте: ${lines.join('; ')}. Предварительно ${rub(total)}.`;
      const url = new URL(cta.dataset.formHref!, location.href);
      url.searchParams.set('message', message);
      cta.href = url.pathname + url.search + url.hash;
    };
    root.addEventListener('input', update);
    root.addEventListener('change', update);
    update();
  }
</script>
